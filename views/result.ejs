<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registration Confirmation - Student Academic Portal</title>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Bootstrap 5 CSS CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  
  <!-- Bootstrap Icons CDN -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <!-- Custom Task 3 Advanced CSS -->
  <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-light d-flex align-items-center justify-content-center min-vh-100 py-5">

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-6">
        
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden animate-fade-in-up">
          <!-- Top Header Banner -->
          <div class="bg-primary text-white p-4 text-center position-relative">
            <div class="d-inline-flex align-items-center justify-content-center w-16 h-16 rounded-circle bg-white text-primary mb-3 shadow" style="width: 64px; height: 64px; font-size: 1.75rem;">
              <i class="bi bi-check-circle-fill text-success"></i>
            </div>
            <h1 class="h3 font-heading fw-bold mb-1">Registration Successful!</h1>
            <p class="mb-0 text-white-50">Welcome, <%= name %></p>
          </div>

          <div class="card-body p-4 p-md-5">
            <div class="alert alert-custom-success mb-4 text-center">
              <i class="bi bi-info-circle-fill me-1"></i> Form processed via <strong>Server-Side Rendering (SSR)</strong>
            </div>

            <div class="bg-light rounded-3 p-3 p-md-4 mb-4 border">
              <h2 class="h6 font-heading fw-bold text-uppercase tracking-wider text-muted mb-3 border-bottom pb-2">
                <i class="bi bi-card-checklist me-1 text-primary"></i> Application Summary
              </h2>

              <div class="row g-3">
                <div class="col-sm-6">
                  <span class="text-muted small d-block">Full Name</span>
                  <strong class="text-dark"><%= name %></strong>
                </div>

                <div class="col-sm-6">
                  <span class="text-muted small d-block">Email Address</span>
                  <strong class="text-dark font-mono small"><%= email %></strong>
                </div>

                <div class="col-sm-6">
                  <span class="text-muted small d-block">Student Age</span>
                  <strong class="text-dark"><%= age %> Years</strong>
                </div>

                <div class="col-sm-6">
                  <span class="text-muted small d-block">Verification Status</span>
                  <span class="badge bg-success"><i class="bi bi-shield-check me-1"></i> Verified</span>
                </div>

                <div class="col-12 pt-2 border-top">
                  <span class="text-muted small d-block">Enrolled Degree Course</span>
                  <strong class="text-primary font-heading fs-6"><%= course %></strong>
                </div>
              </div>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2">
              <a href="/" class="btn btn-custom-primary w-100">
                <i class="bi bi-arrow-left-circle me-1"></i> Return to Portal Home
              </a>
              <button onclick="window.print()" class="btn btn-custom-secondary w-100">
                <i class="bi bi-printer me-1"></i> Print Summary
              </button>
            </div>
          </div>

          <div class="card-footer bg-white border-top text-center py-3 text-muted small">
            <span class="font-mono">Task 3 — Express + EJS + Bootstrap 5</span>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Bootstrap 5 Bundle JS CDN -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
